# ──────────────────────────────────────────────────────────────────────
# english-feedback 환경변수 템플릿
#
# 사용법:
#   1) 이 파일을 .env 로 복사:  cp .env.example .env
#   2) .env 안의 빈 값을 본인 값으로 채운 뒤 저장
#   3) .env 는 .gitignore 에 의해 추적 제외됨 (안전)
#
# ⚠️ GitHub Actions cron 은 이 .env 파일을 사용하지 않습니다.
#    cron 환경에서는 GitHub repo Settings → Secrets and variables → Actions
#    경로로 동일 이름의 Secret 을 등록해야 합니다.
#    이 .env 는 로컬 테스트(직접 python process_lesson.py 실행) 전용입니다.
# ──────────────────────────────────────────────────────────────────────

# ▸ Google Drive 서비스 계정 (JSON 을 base64 인코딩한 1줄 문자열)
#   발급: Google Cloud Console → 서비스 계정 → 키 → JSON → base64 -i FILE
GOOGLE_CREDENTIALS=

# ▸ Groq API 키 (Whisper STT + 백업 LLM)
#   발급: https://console.groq.com/keys  (sk- 또는 gsk_ 로 시작)
GROQ_API_KEY=

# ▸ Gemini API 키 (메인 LLM — 전사 보정 / 화자 검증 / 피드백 생성 / 검토)
#   발급: https://aistudio.google.com/apikey  (AIzaSy 로 시작, 39자)
#   ★ english-feedback 단독 quota 분리를 위해 별도 GCP Project 에서 발급 권장
GEMINI_API_KEY=

# ▸ Gmail 발신 주소
GMAIL_ADDRESS=

# ▸ Gmail 앱 비밀번호 (일반 비밀번호 아님, 16자 코드)
#   발급: Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호
GMAIL_APP_PASSWORD=

# ▸ 피드백 수신 이메일 (미설정 시 기본값 사용)
RECIPIENT_EMAIL=

# ▸ Google Drive 녹음 파일 폴더 ID (URL 끝의 긴 문자열)
DRIVE_FOLDER_ID=

# ▸ 처리 완료 녹음 파일을 이동시킬 폴더 ID (선택)
DRIVE_DONE_FOLDER_ID=

# ▸ GitHub Pages 복습 페이지 URL (예: https://USER.github.io/english-feedback)
GITHUB_PAGES_URL=

# ▸ telegram-notify-hub 알림 (옵션) — 피드백 완료/실패를 텔레그램으로 발송
#   KNH_SEND_SECRET 만 있으면 동작. 미설정 시 발송 건너뜀(이메일엔 영향 없음).
#   값: telegram-notify-hub 의 SEND_SECRET 과 동일. cron 에서는 동일 이름 GitHub Secret 등록.
KNH_SEND_SECRET=
KNH_URL=https://telegram-notify-hub.dk0327.workers.dev
KNH_CHANNEL=telegram
